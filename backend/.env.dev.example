# Entorno de desarrollo local de la API. Copia a backend/.env.dev y úsalo con:
#   uv run --env-file .env.dev <comando>
# Requiere el PostgreSQL de desarrollo: docker compose -f docker-compose.dev.yml up -d --wait
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://humanaiz:humanaiz@127.0.0.1:54329/humanaiz
# Solo para desarrollo. En producción genera uno con: openssl rand -hex 48
JWT_SECRET=desarrollo-local-no-usar-en-produccion-0123456789abcdef
STORAGE_LOCAL_PATH=./data/uploads
MIN_FREE_DISK_MB=0
ENABLE_DOCS=true

# Cuentas de prueba locales (se muestran en la pantalla de login).
DEMO_MODE=true
DEMO_COLABORADOR_DNI=40000001
DEMO_COLABORADOR_PASSWORD=demo-colaborador
DEMO_RRHH_DNI=40000002
DEMO_RRHH_PASSWORD=demo-rrhh
