# Copia este archivo a .env y completa los valores. El .env nunca se versiona.
#
# HumanAIz NO usa claves de IA del servidor: cada usuario aporta la suya por
# petición. No definas OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY ni
# variables de proxy: en producción la API se niega a arrancar si existen.

# --- Sitio ---------------------------------------------------------------
ENVIRONMENT=production
# Dominio público. Caddy obtiene el certificado TLS automáticamente.
SITE_ADDRESS=descansos.example.com
# Origen exacto que verán los navegadores (se valida en login y sesión).
PUBLIC_ORIGIN=https://descansos.example.com
LOG_LEVEL=INFO
TZ_NEGOCIO=America/Lima
# Solo si otro servicio ya ocupa los puertos 80/443 del host.
# HTTP_PORT=80
# HTTPS_PORT=443
# Detrás de OTRO proxy inverso que ya termina TLS: sirve HTTP plano en el
# puerto que elijas y declara la red de ese proxy (ver README).
# SITE_ADDRESS=:80
# HTTP_PORT=8080
# TRUSTED_PROXIES=10.0.0.0/8

# --- Proyecto ------------------------------------------------------------
# Se muestran en el aviso permanente, el pie de página y los textos legales.
# Nombre del concurso al que se presenta el proyecto (opcional).
CONCURSO_NOMBRE=Hackathon - Grupo Rocio
# Puesto obtenido, si ya se conoce (1 = ganador). Vacío: no se muestra.
CONCURSO_PUESTO=1
# Correo o URL de contacto del equipo, para consultas y solicitudes de datos.
CONTACTO_PROYECTO=me@vfernandezg.dev
# Días que se conserva la bitácora de auditoría (incluye IPs).
AUDIT_RETENTION_DAYS=30

# --- Base de datos -------------------------------------------------------
POSTGRES_DB=humanaiz
POSTGRES_USER=humanaiz
# Genera una con: openssl rand -hex 24   (evita caracteres como @ : / ?)
POSTGRES_PASSWORD=

# --- Sesiones ------------------------------------------------------------
# Genera uno con: openssl rand -hex 48   (mínimo 32 bytes)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_IDLE_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=604800
COOKIE_SECURE=true

# --- Archivos ------------------------------------------------------------
# Solo imágenes JPG, PNG o WebP. El servidor guarda una copia re-codificada
# (máx. 2400 px de lado, sin metadatos) y descarta el archivo original.
# 5 MB por imagen. Si lo subes, amplía también `max_size` en deploy/Caddyfile.
MAX_UPLOAD_BYTES=5242880
# Se rechazan subidas si el disco baja de este margen...
MIN_FREE_DISK_MB=500
# ...o si las imágenes guardadas ya ocupan esto en total (0 = sin tope).
STORAGE_MAX_MB=2048
# Dónde se guardan: local (volumen) o database (PostgreSQL, para plataformas sin
# disco persistente; lo usa la imagen única del Dockerfile de la raíz).
STORAGE_BACKEND=local

# --- Análisis con IA (BYOK) ----------------------------------------------
# Proveedores que se ofrecen en la interfaz (cada usuario aporta su propia clave).
LLM_ENABLED_PROVIDERS=anthropic,openai,gemini,openrouter,xai,mistral,groq
LLM_REQUEST_TIMEOUT_SECONDS=90
ANALYSIS_DEADLINE_SECONDS=100
ANALYSIS_MAX_CONCURRENCY=8

# --- Límites de uso ------------------------------------------------------
# memory:// es exacto con una sola réplica. Con varias, usa redis://host:6379.
# Cada límite se aplica por usuario (o visitante de la demo) y por IP (el
# triple). Quien cambia de navegador o usa una VPN esquiva esas dos capas: por
# eso las acciones que gastan recursos del servidor tienen además un tope TOTAL,
# común a todos, que no depende de quién llama.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5/minute
# Intentos contra una misma cuenta real desde cualquier IP (no aplica a la demo).
RATE_LIMIT_LOGIN_DNI=30/hour
RATE_LIMIT_UPLOAD=10/hour
RATE_LIMIT_UPLOAD_GLOBAL=300/hour
RATE_LIMIT_ANALYSIS=30/hour
# Comprobaciones de clave / listados de modelos.
RATE_LIMIT_MODELOS=30/hour
RATE_LIMIT_MODELOS_GLOBAL=300/hour

# --- Modo demo -----------------------------------------------------------
# Con DEMO_MODE=true se siembran dos usuarios de prueba cuyas credenciales se
# muestran en la pantalla de login. Son públicas a propósito: elige valores
# que no uses en ningún otro sitio. El modo demo y los usuarios reales son
# excluyentes: la API no arranca si se mezclan.
DEMO_MODE=false
DEMO_TTL_HOURS=24
DEMO_SESSION_TTL_SECONDS=7200
DEMO_MAX_DESCANSOS_PER_VISITOR=5
DEMO_COLABORADOR_DNI=
DEMO_COLABORADOR_PASSWORD=
DEMO_RRHH_DNI=
DEMO_RRHH_PASSWORD=
